msgstr "Esta lista tem de ter pelo menos {min_length} elementos."

#. por traduzir no pt_PT do DRF
msgid "Ensure this field has no more than {max_length} elements."
msgstr "Esta lista não pode ter mais de {max_length} elementos."

#. por traduzir no pt_PT do DRF
msgid "Invalid datetime for the timezone \"{timezone}\"."
msgstr "Data e hora inválidas para o fuso horário «{timezone}»."

#. por traduzir no pt_PT do DRF
msgid "Invalid input."
msgstr "Dados inválidos."

#. por traduzir no pt_PT do DRF
msgid "Must be a valid UUID."
msgstr "Tem de ser um UUID válido."

#. por traduzir no pt_PT do DRF
msgid "Must be a valid boolean."
msgstr "Tem de ser verdadeiro ou falso."

#. por traduzir no pt_PT do DRF
msgid "Not a valid string."
msgstr "Não é texto válido."

#. marcador pt-BR: «requisição»
msgid "Could not satisfy the request Accept header."
msgstr "Não foi possível satisfazer o cabeçalho Accept do pedido."

#. marcador pt-BR: «a seguir»
msgid "Datetime has wrong format. Use one of these formats instead: {format}."
msgstr "Data e hora em formato inválido. Use um destes formatos: {format}."

#. erro ortográfico no pt_PT do DRF: «Certifque-se»
msgid "Ensure this value is greater than or equal to {min_value}."
msgstr "Certifique-se de que este valor é maior ou igual a {min_value}."

#. marcador pt-BR: «a seguir», e «Tempo» por «Hora»

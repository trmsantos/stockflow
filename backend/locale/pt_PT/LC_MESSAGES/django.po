# Tradução pt-PT **do projecto**, que sobrepõe a dos pacotes (ADR 0019, decisão 4).
#
# Porque é que este ficheiro existe
# ---------------------------------
# Com `LANGUAGE_CODE = "pt-pt"`, o Django e o DRF serviam a um utilizador
# português: oito mensagens **em inglês** ("Must be a valid UUID."), seis com
# vocabulário pt-BR ("Use um dos formatos a seguir", "mídia", "Você"), um erro
# ortográfico do próprio catálogo ("Certifque-se") e uma frase de 429 partida ao
# meio ("Pedido foi limitado. Expected available in 42 seconds."). Mudar o código
# de língua não corrige nada: `pt` dá as mesmas frases.
#
# O `LOCALE_PATHS` é fundido **depois** dos catálogos das apps e a fusão
# sobrepõe, logo o que está aqui ganha ao `pt_PT` do DRF.
#
# Como é que esta lista foi escolhida
# -----------------------------------
# **Derivada de uma medição e não adivinhada**, que é o método do gate de cor
# ("calcula a pior superfície em vez de a nomear"): um varredor percorre os
# `default_error_messages` dos campos que esta API usa e as `APIException` que
# ela emite, traduz cada msgid sob `activate("pt-pt")` e separa em três — por
# traduzir, com marcador pt-BR, e aceitável. Deu **14 de 34**, e os msgid deste
# ficheiro foram **gerados** a partir dessa varredura: um erro de dedo num msgid
# faz a sobreposição falhar em silêncio.
#
# As duas últimas entradas não vieram do varredor e isso está dito em cada uma:
# o gate apanha marcadores de vocabulário, **não** apanha gramática. É regra de
# revisão e não mecanismo, e diz-se em vez de se prometer.
#
# O que **não** está aqui: as centenas de msgid do catálogo do DRF que esta API
# nunca emite. Traduzi-las era trabalho a fingir, e um fork do catálogo derivava
# a cada actualização do DRF sem nada que o dissesse.
#
# O `.po` é commitado e o `.mo` não: o `compilemessages` corre no stage `builder`
# do `docker/backend.Dockerfile` e no CI, e quem apanha um compile esquecido é o
# `tests/test_i18n.py` — um msgid que se traduz para si mesmo é vermelho.
msgid ""
msgstr ""
"Project-Id-Version: StockFlow\n"
"Report-Msgid-Bugs-To: \n"
"PO-Revision-Date: 2026-10-07\n"
"Last-Translator: StockFlow\n"
"Language-Team: pt-PT\n"
"Language: pt_PT\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#. por traduzir no pt_PT do DRF
msgid "Datetime value out of range."
msgstr "Data e hora fora dos limites."

#. por traduzir no pt_PT do DRF
msgid "Ensure this field has at least {min_length} elements."
msgstr "Esta lista tem de ter pelo menos {min_length} elementos."

#. por traduzir no pt_PT do DRF
msgid "Ensure this field has no more than {max_length} elements."
msgstr "Esta lista não pode ter mais de {max_length} elementos."

#. por traduzir no pt_PT do DRF
msgid "Invalid datetime for the timezone \"{timezone}\"."
msgstr "Data e hora inválidas para o fuso horário «{timezone}»."

#. por traduzir no pt_PT do DRF
msgid "Invalid input."
msgstr "Dados inválidos."

#. por traduzir no pt_PT do DRF
msgid "Must be a valid UUID."
msgstr "Tem de ser um UUID válido."

#. por traduzir no pt_PT do DRF
msgid "Must be a valid boolean."
msgstr "Tem de ser verdadeiro ou falso."

#. por traduzir no pt_PT do DRF
msgid "Not a valid string."
msgstr "Não é texto válido."

#. marcador pt-BR: «requisição»
msgid "Could not satisfy the request Accept header."
msgstr "Não foi possível satisfazer o cabeçalho Accept do pedido."

#. marcador pt-BR: «a seguir»
msgid "Datetime has wrong format. Use one of these formats instead: {format}."
msgstr "Data e hora em formato inválido. Use um destes formatos: {format}."

#. erro ortográfico no pt_PT do DRF: «Certifque-se»
msgid "Ensure this value is greater than or equal to {min_value}."
msgstr "Certifique-se de que este valor é maior ou igual a {min_value}."

#. marcador pt-BR: «a seguir», e «Tempo» por «Hora»
msgid "Time has wrong format. Use one of these formats instead: {format}."
msgstr "Hora em formato inválido. Use um destes formatos: {format}."

#. marcador pt-BR: «mídia»
msgid "Unsupported media type \"{media_type}\" in request."
msgstr "O tipo de conteúdo «{media_type}» do pedido não é suportado."

#. marcador pt-BR: «Você», «essa ação»
msgid "You do not have permission to perform this action."
msgstr "Não tem permissão para executar esta ação."

#. concordância: «um escolha válido»; o gate de marcadores não apanha gramática
msgid "\"{input}\" is not a valid choice."
msgstr "«{input}» não é uma opção válida."

#. a frase inteira, porque a segunda metade saía em inglês
msgid "Request was throttled."
msgstr "O pedido foi recusado por exceder o limite."

#. A segunda metade do 429 saía em inglês, e **as duas entradas são singulares
#. de propósito** — um par `msgid_plural` aqui não funciona, e a razão é fina.
#.
#. O `Throttled.__init__` do DRF chama
#. `ngettext(self.extra_detail_singular, self.extra_detail_plural, wait)` com os
#. dois atributos, que são objectos **lazy**. Um lazy avalia-se na língua activa,
#. logo a chave com que o `ngettext` procura o plural já vem traduzida — e uma
#. chave portuguesa não acerta num catálogo indexado pelo msgid inglês. O
#. `gettext` cai então no `msgid2`, que é o segundo lazy, e esse resolve-se por
#. `gettext` simples.
#.
#. Medido, e o sintoma era enganador: com o par de plural, `wait=1` saía em
#. português (por acidente — o fallback devolve o `msgid1`, que já é o lazy
#. traduzido) e `wait=42` saía em inglês. Meia frase certa é pior do que a frase
#. errada, porque não se nota.
#.
#. Duas entradas singulares resolvem os dois caminhos: cada lazy resolve-se por
#. `gettext` e o fallback do `ngettext` devolve a forma certa para qualquer `n`.
#. E continuam a resolver se o DRF algum dia passar strings em vez de lazies: aí
#. a procura do plural falha, cai no `msgid2`, e o `msgid2` está aqui.
msgid "Expected available in {wait} second."
msgstr "Tente outra vez dentro de {wait} segundo."

msgid "Expected available in {wait} seconds."
msgstr "Tente outra vez dentro de {wait} segundos."

# ===========================================================================
# As nossas mensagens (ADR 0019, decisão 4)
# ===========================================================================
# As frases que esta app escreve e que chegam ao utilizador: o `detalhe` das
# recusas e as mensagens de validação escritas à mão. As do DRF estão acima.
#
# O português aqui é **igual ao que a app servia antes de este catálogo
# existir** — palavra por palavra, incluindo o "activar" com c do
# `DETALHE`/`password` e o "rotas repetidas" em minúscula. Não é descuido: esta
# alteração move strings, não as reescreve, e um utilizador português não deve
# notar nada. A copy melhora-se num diff que seja sobre copy.
#
# Os `{nome}` são interpolados **depois** da tradução, com `.format()`: um
# f-string antes do `_()` fazia o msgid variar com os dados e nenhuma tradução
# o alcançava.

msgid "Wrong email or password."
msgstr "Email ou password incorretos."

msgid "You do not have active access to this establishment."
msgstr "Não tem acesso ativo a este estabelecimento."

msgid "No active establishment in this session."
msgstr "Não há estabelecimento ativo nesta sessão."

msgid "The establishment of this request is not the one in the session. Reload before continuing."
msgstr "O estabelecimento deste pedido não é o da sessão. Recarregue antes de continuar."

msgid "This invitation is not valid. Ask for a new one."
msgstr "Este convite não é válido. Peça um convite novo."

msgid "This account already exists. Sign in and open the link again to accept."
msgstr "Esta conta já existe. Inicie sessão e abra o link outra vez para aceitar."

msgid "This invitation is for another account. Sign out and sign in with the invited account."
msgstr "Este convite é para outra conta. Termine a sessão e entre com a conta convidada."

msgid "There is already an invitation for this email in this establishment. Resend it or revoke it."
msgstr "Já existe um convite para este email neste estabelecimento. Reenvie-o ou revogue-o."

msgid "This person is already a member of this establishment."
msgstr "Esta pessoa já é membro deste estabelecimento."

msgid "Choose a password to activate your account."
msgstr "Escolha uma password para activar a sua conta."

msgid "Too many failed sign-in attempts. This account is temporarily locked; try again later."
msgstr "Demasiadas tentativas de entrada falhadas. Esta conta está temporariamente bloqueada; tente mais tarde."

msgid "Repeated routes in the menu: {rotas}. The PUT is a full replacement and each route appears at most once."
msgstr "rotas repetidas no menu: {rotas}. O PUT é uma substituição total e cada rota aparece no máximo uma vez."

msgid "The business day starts between {minimo} and {maximo}. This hour separates one day from the next in the totals: outside this window, an evening service would be split across two days."
msgstr "O dia de negócio começa entre as {minimo} e as {maximo}. Esta hora separa um dia do seguinte nos totais: fora desta janela, um serviço de noite ficaria partido em dois dias."

msgid "There is no account with the email {email}. The demo does not create accounts."
msgstr "Não existe conta com o email {email}. O demo não cria contas."

msgid "This is the demonstration establishment: the name does not change. The rest of the configuration changes normally."
msgstr "Este é o estabelecimento de demonstração: o nome não se altera. O resto da configuração muda normalmente."

# ---------------------------------------------------------------------------
# O recurso /documents (ADR 0021, fatia 1)
# ---------------------------------------------------------------------------
# As quatro recusas do `purchasing/services.py` e as quatro validações de
# ficheiro do `purchasing/serializers.py`. Os `{nome}` são interpolados **depois**
# da tradução, com `.format()`: um f-string antes do `_()` fazia o msgid variar
# com os dados e nenhuma tradução o alcançava.
#
# A frase do tipo recusado diz **o que se aceita** e não "tipo inválido", de
# propósito: a lista é fechada (PDF, JPEG, PNG) e quem recebe a recusa tem de
# saber o que enviar em vez de adivinhar.

msgid "This document is closed and does not take more pages. Open a new one."
msgstr "Este documento está fechado e não aceita mais páginas. Abra um novo."

msgid "This document was discarded."
msgstr "Este documento foi descartado."

msgid "This document has no pages yet, so there is nothing to close."
msgstr "Este documento ainda não tem páginas, logo não há nada para fechar."

msgid "A document takes at most {limite} pages."
msgstr "Um documento aceita no máximo {limite} páginas."

msgid "Only a PDF, a JPEG or a PNG. What decides is the content of the file and never its name or the declared type."
msgstr "Só um PDF, um JPEG ou um PNG. O que decide é o conteúdo do ficheiro e nunca o seu nome nem o tipo declarado."

msgid "This file has no content."
msgstr "Este ficheiro não tem conteúdo."

msgid "This file is larger than {limite} MiB."
msgstr "Este ficheiro é maior do que {limite} MiB."

msgid "This PDF has {paginas} pages and a document takes at most {limite}."
msgstr "Este PDF tem {paginas} páginas e um documento aceita no máximo {limite}."

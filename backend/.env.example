# .env.example — copia para `.env` e preenche. O `.env` está no .gitignore.
#
# Em produção NADA disto vem de um ficheiro: as variáveis são injetadas pelo
# orquestrador ou por Docker secrets (SECURITY.md §8).
#
# Regra: as variáveis marcadas [obrigatória] não têm default em nenhum
# ambiente. Sem elas o Django não arranca — de propósito.

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev

# [obrigatória] >= 50 caracteres. Gera uma com:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

DJANGO_DEBUG=true
DJANGO_LOG_LEVEL=INFO

# Path do admin, fora do default `admin/` (SECURITY.md §5).
# [obrigatória em prod]
# `ADMIN_PATH` é a fonte de verdade e alimenta os dois lados: o
# `DJANGO_ADMIN_URL` do Django (o compose deriva-o daqui) e o
# `docker/caddy/proxy.Caddyfile`, que é quem tem o rate limit de 5/min e o
# matcher de CIDRs. **Sem barras** — o `admin_path()` do Django normaliza-as, o
# matcher do Caddy não, e uma barra a mais larga os três sítios do proxy em
# silêncio.
#
# O `DJANGO_ADMIN_URL` **não** está aqui de propósito: sob compose o
# `environment:` do serviço sobrepõe-no com `${ADMIN_PATH}`, logo definí-lo
# neste ficheiro não fazia nada — e não fazer nada em silêncio é o mesmo modo de
# falha que a variável única veio corrigir. Quem corre o Django fora do compose
# exporta-o à mão; sem ele o default é `gestao-interna/`.
ADMIN_PATH=gestao-interna

# Os CIDRs de onde o admin é alcançável, impostos no proxy. O default **não
# restringe nada** e está nomeado como tal no SECURITY.md §5: em dev não pode
# restringir, porque o Docker Desktop faz NAT e o IP do host é imprevisível.
# **Produção tem de a definir**, ou pôr a restrição no orquestrador. Faltava
# deste ficheiro, que é o único sítio que lista os manípulos — uma variável
# obrigatória em produção que não aparece na lista é uma que ninguém define.
# [obrigatória em prod]
ADMIN_ALLOW_CIDRS=0.0.0.0/0 ::/0

# Só lidas em prod (em dev os defaults do ADR 0002 já bastam).
# **Comentadas de propósito, e isto foi um defeito a sério.** Activas, qualquer
# cópia deste ficheiro faz o `manage.py runserver` responder **400 DisallowedHost
# a todos os pedidos** em `localhost`, porque o `.env` sobrepõe os defaults de
# dev do `config/settings/dev.py` (que já são os certos, pelo ADR 0002). O
# comentário acima dizia "só lidas em prod" e as linhas estavam ligadas: o
# ficheiro dizia uma coisa e fazia outra.
#
# Em produção descomenta-as e põe os teus domínios.
# ALLOWED_HOSTS=stockflow.example.pt
# CSRF_TRUSTED_ORIGINS=https://stockflow.example.pt

# Nº de proxies de confiança à frente do Django (o Caddy/nginx conta 1). Cada
# um acrescenta à direita do X-Forwarded-For o endereço que viu, logo o cliente
# real está a TRUSTED_PROXY_COUNT posições da direita. Identifica o cliente no
# rate limit de login (django-axes) e no throttle de anónimos (DRF). Só lida em
# prod; em dev e em teste o IP é o REMOTE_ADDR e o header é ignorado.
TRUSTED_PROXY_COUNT=1

# Swagger UI em /api/v1/docs/ (default: ligado em dev, desligado em prod).
API_DOCS_ENABLED=true

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# [obrigatória] Role da aplicação (ADR 0006): liga-se, faz DML, **não é dono de
# nenhuma tabela** e está sujeito à RLS. Não tem CREATE no esquema — um `migrate`
# com esta URL morre no primeiro CREATE TABLE, de propósito.
# Dentro do compose o host é `db` e a porta 5432; de fora é localhost com a porta
# publicada do ADR 0002 (5442).
DATABASE_URL=postgres://stockflow_app:muda-me-app@localhost:5442/stockflow
DATABASE_CONN_MAX_AGE=60

# [obrigatória em quem migra] Role dono da base de dados e das tabelas. É a
# credencial do `migrate` e da criação da BD de teste — nunca a de um processo
# que serve pedidos: os serviços `backend` e `worker` não recebem esta variável.
MIGRATION_DATABASE_URL=postgres://stockflow_owner:muda-me-owner@localhost:5442/stockflow

# Em prod a ligação é sempre `sslmode=verify-full`; aponta para a CA que
# assina o certificado do servidor (vazio = ~/.postgresql/root.crt).
DATABASE_SSLROOTCERT=

# Superuser de bootstrap do cluster (initdb). NÃO é o role da aplicação: serve
# para o healthcheck do compose e para correr `docker/db/roles.sql`.
POSTGRES_DB=stockflow
POSTGRES_USER=stockflow
POSTGRES_PASSWORD=muda-me

# Passwords que o `roles.sql` atribui aos dois roles. Têm de bater com as URLs
# acima — o script não as inventa, lê-as daqui.
STOCKFLOW_APP_PASSWORD=muda-me-app
STOCKFLOW_OWNER_PASSWORD=muda-me-owner

# ---------------------------------------------------------------------------
# Redis, Celery e cache
# ---------------------------------------------------------------------------
# Índices separados: 0 broker, 1 resultados, 2 cache.
REDIS_URL=redis://localhost:6389
CELERY_BROKER_URL=redis://localhost:6389/0
CELERY_RESULT_BACKEND=redis://localhost:6389/1
CACHE_URL=redis://localhost:6389/2

# ---------------------------------------------------------------------------
# Portas publicadas no host (ADR 0002 — nenhuma é a default do serviço, para
# não colidir com outros projetos a correr na mesma máquina).
# Dentro da rede do compose os contentores continuam nas portas canónicas.
# ---------------------------------------------------------------------------
PROXY_PORT=8090
BACKEND_PORT=8010
FRONTEND_PORT=5183
POSTGRES_PORT=5442
REDIS_PORT=6389

# ---------------------------------------------------------------------------
# Email (SMTP) — **opcional**, e hoje sem consumidor nenhum
#
# Nada neste código envia email: o convite é entregue à mão por desenho (ADR
# 0010, e a copy do ecrã diz-no a quem convida) e a reposição de password não
# existe. Estas quatro ficaram obrigatórias durante um dia e isso só comprava um
# valor de fachada para o deploy passar — que parece configurado e falha mais
# tarde. Em dev o `dev.py` escreve na consola; em produção o backend é SMTP e não
# há caminho para a consola, mas um host vazio é aceite enquanto não houver
# remetente.
#
# O dia em que houver um — e o provedor a sério está por escolher (Resend ou
# equivalente) — o `test_o_smtp_volta_a_ser_obrigatorio_quando_alguem_enviar`
# fica vermelho e estas voltam a `required`.
# ---------------------------------------------------------------------------
# O `dev.py` escreve os emails na consola e o `test.py` guarda-os em memória,
# logo nada disto é preciso para desenvolver. Em produção **são obrigatórios**:
# sem eles o processo não arranca, e é de propósito — um default que caísse na
# consola dava um convite "enviado" para o stdout de um contentor, sem erro
# nenhum, com a pessoa do outro lado à espera.
#
# O TLS é derivado da porta e não é configurável: 587 é STARTTLS, 465 é TLS
# implícito, e não há caminho para desligar os dois.
# EMAIL_HOST=smtp.exemplo.pt
# EMAIL_PORT=587
# EMAIL_HOST_USER=stockflow@exemplo.pt
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=StockFlow <stockflow@exemplo.pt>

# ---------------------------------------------------------------------------
# Chat sobre stock (ADR 0027). Só o `worker` fala com a rede: a chave entra só
# no ambiente do worker, nunca no do backend (ver docker/compose.yml).
# ---------------------------------------------------------------------------
# O modelo que responde (default: o mais barato que faz tool-use). Vazio desliga
# o assistente: o POST responde 503 `assistente_indisponivel`.
AGENTS_CHAT_MODEL=gpt-5-mini
# [segredo] A chave de API da OpenAI, criada pelo dono. Vazia = assistente
# desligado. Nunca commitada; em produção vem de um Docker secret.
AGENTS_CHAT_API_KEY=
# URL base de um fornecedor OpenAI-compatível com nível gratuito; vazia = OpenAI.
#   Google AI Studio: https://generativelanguage.googleapis.com/v1beta/openai/  (modelo gemini-3.1-flash-lite — o mais rápido no nível grátis a 2026-10-15: ~1 s por chamada)
#   Groq:             https://api.groq.com/openai/v1                           (modelo llama-3.3-70b-versatile)
#   GitHub Models:    https://models.github.ai/inference                        (modelo openai/gpt-4o-mini)
AGENTS_CHAT_BASE_URL=
# Tokens de saída por chamada (`max_completion_tokens` na API).
AGENTS_CHAT_MAX_TOKENS=1024
# Segundos por chamada ao modelo, e chamadas a tools por pergunta.
AGENTS_CHAT_TIMEOUT_S=30
AGENTS_CHAT_MAX_TOOL_ITERATIONS=6
# Os dois tetos diários (SECURITY.md §6): euros por estabelecimento e
# perguntas por pessoa. Baixos de propósito nesta fase.
AGENTS_CHAT_DAILY_BUDGET_EUR=0.50
AGENTS_CHAT_DAILY_MESSAGES_PER_USER=30
# Dias até uma conversa ser apagada pela purga diária (RGPD).
AGENTS_CHAT_RETENTION_DAYS=90

# ---------------------------------------------------------------------------
# Extração de faturas (ADR 0031). Só o `worker` fala com a rede, como no chat.
# ---------------------------------------------------------------------------
# AVISO DE PRIVACIDADE, do dono (2026-10-19): enquanto isto correr num nível
# gratuito, usa-se **só com faturas inventadas** — o nível gratuito de um
# fornecedor costuma treinar com o que lhe entra, e uma fatura traz os dois NIF
# e uma morada. O escalão pago proposto é `gemini-2.5-flash` (~1 €/mês por
# estabelecimento), e a decisão fica ao dono.
#
# O modelo de visão que lê um documento. Vazio **desliga** a extração: a
# tentativa fica gravada com `erro` e a razão legível, e ninguém paga nada.
AGENTS_EXTRACTION_MODEL=
# A URL base e a chave caem para as do chat quando ficam vazias. Preenche-as
# só no dia em que as faturas tiverem de ir para outra conta.
AGENTS_EXTRACTION_BASE_URL=
# [segredo] Vazia = usa AGENTS_CHAT_API_KEY.
AGENTS_EXTRACTION_API_KEY=
# Páginas por chamada (uma chamada por documento), tokens de saída e segundos.
AGENTS_EXTRACTION_MAX_PAGES=10
AGENTS_EXTRACTION_MAX_TOKENS=8000
AGENTS_EXTRACTION_TIMEOUT_S=120
# Teto diário em euros **por estabelecimento** (não por pessoa) e tentativas
# por documento.
AGENTS_EXTRACTION_DAILY_BUDGET_EUR=1.00
AGENTS_EXTRACTION_MAX_ATTEMPTS=3
# Abaixo deste valor uma linha fica marcada no ecrã de revisão. Marca e mais
# nada: a confiança nunca bloqueia uma confirmação. Hipótese, não medição.
AGENTS_EXTRACTION_CONFIDENCE_THRESHOLD=0.80

# Serve só os estáticos do Vite. Não é o proxy da aplicação — esse é o
# `docker/caddy/proxy.Caddyfile`, e é o único que expõe portas ao exterior.
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	# Os assets do Vite levam hash no nome, logo são imutáveis: um ano de cache.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# O index.html nunca é cacheado, senão um deploy novo continua a servir o
	# HTML antigo, que referencia assets que já não existem.
	@html path / /index.html
	header @html Cache-Control "no-cache"

	# SPA: qualquer caminho que não seja ficheiro cai no index.html.
	try_files {path} /index.html
	file_server

	log {
		output stdout
		format json
	}
}
